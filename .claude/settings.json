{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv sync:*)"
    ],
    "deny": [
      "Read(./holdout/**)",
      "Edit(./holdout/**)",
      "Bash(*holdout*)",
      "Read(./.env)",
      "Bash(pip install:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {}
}
