{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv sync:*)"
    ],
    "deny": [
      "Read(./holdout/**)",
      "Edit(./holdout/**)",
      "Bash(*holdout*)",
      "Read(./.env)",
      "Bash(pip install:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --frozen --quiet --project \"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard_write.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
